# ─── MailMind configuration ───────────────────────────────────────────────────
# Copy to .env and fill in. Everything here is server-side only — none of these
# values are ever sent to the browser.

APP_URL="http://localhost:3000"
# Time zone used when the AI reads dates ("Monday 10 AM"). IANA name.
APP_TIMEZONE="UTC"
LOG_LEVEL="info"

# ── Database: MongoDB Atlas ──
# Atlas → Connect → Drivers. The free M0 tier works, including Atlas Vector Search.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mailmind"
# No Atlas yet? `npm run db:local` starts a local MongoDB; then use:
# MONGODB_URI="mongodb://127.0.0.1:27017"

# ── Security ──
# 32 random bytes; encrypts OAuth tokens at rest. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ── AI: Claude via LangChain ──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Optional: a different model for the per-email pipeline steps (classify, extract, …).
# ANTHROPIC_PIPELINE_MODEL=""
# Server-side refusal fallbacks for single-shot calls (pipeline, drafts, RAG).
ANTHROPIC_REFUSAL_FALLBACKS="true"
# Run the AI pipeline automatically when new emails arrive.
AI_AUTO_PROCESS="true"

# ── Embeddings (semantic search) ──
# "voyage" (recommended) or "mock" (offline, lexical; default when no key is set).
EMBEDDINGS_PROVIDER=""
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3.5"
VOYAGE_DIMENSIONS="1024"
ATLAS_VECTOR_INDEX="email_embeddings_vector"

# ── Email ──
# Mock Email Mode: a demo inbox, so you can develop without a real account.
MOCK_EMAIL_MODE="true"
# Gmail (optional): Google Cloud console → OAuth client (Web). Authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── Redis (optional) ──
# Rate limits, locks and caches. Without it, an in-process fallback is used (single instance only).
# REDIS_URL="redis://localhost:6379"
