# ─── MailMind configuration ───────────────────────────────────────────────────
# Copy to .env and fill in. Everything here is server-side only — none of these
# values are ever sent to the browser. Full reference: docs/11-configuration.md

APP_URL="http://localhost:3000"
# Time zone used when the AI reads dates ("Monday 10 AM"). IANA name.
APP_TIMEZONE="UTC"
LOG_LEVEL="info"

# ── Database: MongoDB Atlas ──
# Atlas → Connect → Drivers. The free M0 tier works, including Atlas Vector Search.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="mailmind"

# ── Security ──
# 32 random bytes; encrypts Gmail OAuth tokens at rest. Required in production.
# Set it before connecting Gmail and keep it stable (changing it invalidates stored tokens).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ── AI: Google Gemini (https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=""
# Agent, reply drafts and RAG answers.
GEMINI_MODEL="gemini-3.5-flash"
# Per-email pipeline steps (classify, extract, summarise, urgency, memory).
GEMINI_PIPELINE_MODEL="gemini-3.5-flash-lite"
# Run the AI pipeline automatically on newly arrived mail …
AI_AUTO_PROCESS="true"
# … for at most this many emails per sync (newest first). Protects free-tier quota.
AI_AUTO_PROCESS_LIMIT="25"

# ── Gmail (required) ──
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Days of mail the first sync imports, and the cap per sync run.
GMAIL_INITIAL_SYNC_DAYS="30"
GMAIL_SYNC_MAX_MESSAGES="200"
# Open tabs check Gmail for new mail this often (seconds). 0 = only the Sync button.
GMAIL_POLL_SECONDS="60"

# ── Redis (optional) ──
# Rate limits, locks and caches. Without it, an in-process fallback is used (single instance only).
# REDIS_URL="redis://localhost:6379"
